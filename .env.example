# ProjectMind Optional Environment Configuration
# ProjectMind is 100% local-first and does not require cloud API keys or external databases.

# Override the ProjectMind runtime installation directory (optional)
# PROJECTMIND_HOME=/usr/local/lib/node_modules/projectmind

# Override the target project workspace directory (optional)
# PROJECTMIND_PROJECT_ROOT=/path/to/target/project

# Enable verbose diagnostic logging (optional)
# DEBUG=projectmind:*

# Custom port if hosting MCP over SSE/HTTP (default: stdio)
# MCP_PORT=3000
