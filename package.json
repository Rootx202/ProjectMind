{
  "name": "@rootx202/projectmind",
  "version": "2.0.0",
  "description": "ProjectMind \u2014 Universal Local-First AI Project Intelligence and Persistent Context Engine",
  "private": false,
  "license": "MIT",
  "author": "Rootx202",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rootx202/ProjectMind.git"
  },
  "homepage": "https://github.com/Rootx202/ProjectMind#readme",
  "bugs": {
    "url": "https://github.com/Rootx202/ProjectMind/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bin": {
    "projectmind": "./bin/projectmind.js",
    "projectmind-mcp": "./bin/projectmind-mcp.js"
  },
  "files": [
    "apps",
    "packages",
    "adapters",
    "skills",
    "plugins",
    "templates",
    "scripts",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "GEMINI.md",
    "tsconfig.json",
    ".claude-plugin",
    "bin",
    ".agents/plugins/projectmind",
    "gemini-extension.json",
    ".mcp.json"
  ],
  "workspaces": [
    "apps/*",
    "packages/*",
    "adapters/*"
  ],
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-transform-modules-commonjs": "^7.24.0",
    "@babel/preset-typescript": "^7.24.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "test": "node scripts/test.js",
    "diagnostics": "node apps/diagnostics/dist/index.js",
    "setup": "node apps/setup/dist/index.js",
    "release:package": "node scripts/package-release.js",
    "benchmark": "node scripts/benchmark.js",
    "test:clean": "node scripts/build.js && node scripts/test.js",
    "postinstall": "node scripts/link-workspaces.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "0.20.8"
  }
}
