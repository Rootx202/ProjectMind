{
  "name": "projectmind",
  "version": "1.1.0",
  "description": "ProjectMind — Universal Local-First AI Project Intelligence and Persistent Context Engine",
  "private": false,
  "license": "MIT",
  "author": "Rootx202",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rootx202/ProjectMind.git"
  },
  "homepage": "https://github.com/Rootx202/ProjectMind#readme",
  "bugs": {
