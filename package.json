    "build": "node scripts/build.js",
    "test": "node scripts/test.js",
    "diagnostics": "node apps/diagnostics/dist/index.js",
    "setup": "node apps/setup/dist/index.js",
    "release:package": "node scripts/package-release.js",
    "benchmark": "node scripts/benchmark.js",
    "test:clean": "node scripts/build.js && node scripts/test.js"
  },
  "dependencies": {
    "@babel/parser": "^7.29.0"
